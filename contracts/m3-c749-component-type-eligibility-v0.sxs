(schema m3-c749-component-type-eligibility-v0
  (primitive name)
  (enum outcome accepted rejected unresolved)
  (enum c749-pointer-or-allocatable-attribute absent present unknown)
  (enum c749-declaration-type-category intrinsic previously-defined-derived enum enumeration other unknown)
  (enum c749-context component-def-stmt other unknown)
  (record source-ref
    (document name)
    (clause name)
    (rule name)
    (page int)
    (source-hash name))
  (record source-span
    (byte-start int)
    (byte-length int)
    (page-start int)
    (page-end int))
  (record component-type-eligibility
    (pointer-or-allocatable-attribute c749-pointer-or-allocatable-attribute)
    (declaration-type-category c749-declaration-type-category)
    (context c749-context))
  (record semantic-candidate
    (id name)
    (property name)
    (source source-ref)
    (span source-span)
    (fact component-type-eligibility)
    (expected outcome))
  (list candidates semantic-candidate))
