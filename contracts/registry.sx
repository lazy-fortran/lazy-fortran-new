(contract-registry
  (revision 0)
  (compatibility additive)
  (contract standardir 0 standard-new fortfront-new ffc-new)
  (contract standardir-grammar 0 standard-new fortfront-new)
  (contract lexical-layout 0 standard-new parser-targets)
  (contract lexical-layout 1 standard-new parser-targets)
  (contract lexical-layout 2 standard-new parser-targets)
  (contract frontend 0 fortfront-new ffc-new tools)
  (contract frontend-ast 0 fortfront-new ffc-new)
  (contract mir 0 ffc-new fortback-new)
  (contract targetir 0 fortback-new backend-generators)
  (contract emission 0 fortback-new ffc-new driver)
  (contract m3-c1106-semantic-oracle 0 lazy-fortran-new)
  (contract m3-c702-semantic-oracle 0 lazy-fortran-new)
  (contract m3-c601-name-length-oracle 0 lazy-fortran-new)
  (contract m3-c603-label-digit-oracle 0 lazy-fortran-new)
  (contract m3-c721-exponent-letter-oracle 0 lazy-fortran-new)
  (contract m3-c725-int-literal-kind-oracle 0 lazy-fortran-new)
  (contract m3-c718-scalar-int-constant-oracle 0 lazy-fortran-new)
  (contract m3-c723-complex-named-constant-oracle 0 lazy-fortran-new)
  (contract m3-c719-kind-param-nonnegative-oracle 0 lazy-fortran-new)
  (contract m3-c738-abstract-deferred-binding-oracle 0 lazy-fortran-new)
  (contract m3-c1579-result-entry-name-oracle 0 lazy-fortran-new)
  (contract m3-c1586-statement-function-self-reference-oracle 0 lazy-fortran-new)
  (contract m3-c729-optional-comma-oracle 0 lazy-fortran-new)
  (contract m3-c717-kind-selector-oracle 0 lazy-fortran-new)
  (contract m3-c720-kind-param-representation-oracle 0 lazy-fortran-new)
  (contract m3-c722-kind-param-approximation-oracle 0 lazy-fortran-new)
  (contract m3-c724-scalar-int-constant-expr-oracle 0 lazy-fortran-new))
