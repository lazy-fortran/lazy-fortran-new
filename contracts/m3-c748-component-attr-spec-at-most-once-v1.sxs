(schema m3-c748-component-attr-spec-at-most-once-v1
  (primitive name)
  (enum outcome accepted rejected unresolved)
  (enum c748-attribute-name-presence absent present unknown)
  (enum c748-definition-occurrence-cardinality zero one many unknown)
  (enum c748-context component-def-stmt other unknown)
  (record source-ref
    (document name)
    (clause name)
    (rule name)
    (page int)
    (source-hash name))
  (record source-span
    (byte-start int)
    (byte-length int)
    (page-start int)
    (page-end int))
  (record component-attr-spec-at-most-once
    (attribute-name-presence c748-attribute-name-presence)
    (definition-occurrence-cardinality c748-definition-occurrence-cardinality)
    (context c748-context))
  (record semantic-candidate
    (id name)
    (property name)
    (source source-ref)
    (span source-span)
    (fact component-attr-spec-at-most-once)
    (expected outcome))
  (list candidates semantic-candidate))
