(schema m3-c759-type-param-value-v0
  (primitive name)
  (enum outcome accepted rejected unresolved)
  (enum type-param-value-kind colon component-specification other unknown)
  (record source-ref (document name) (clause name) (rule name) (page int) (source-hash name))
  (record source-span (byte-start int) (byte-length int) (page-start int) (page-end int))
  (record c759-value-kind (value-kind type-param-value-kind))
  (record semantic-candidate (id name) (property name) (source source-ref) (span source-span) (fact c759-value-kind) (expected outcome))
  (list candidates semantic-candidate))
