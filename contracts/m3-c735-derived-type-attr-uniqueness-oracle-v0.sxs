(schema m3-c735-derived-type-attr-uniqueness-oracle-v0
  (primitive name)
  (enum outcome accepted rejected unresolved)
  (enum c735-attr-occurrence none distinct duplicate unknown)
  (enum c735-context-state derived-type-stmt other unknown)
  (record source-ref
    (document name)
    (clause name)
    (rule name)
    (page int)
    (source-hash name))
  (record source-span
    (byte-start int)
    (byte-length int)
    (page-start int)
    (page-end int))
  (record type-attr-uniqueness-use
    (attr-occurrence c735-attr-occurrence)
    (context c735-context-state))
  (record semantic-candidate
    (id name)
    (property name)
    (source source-ref)
    (span source-span)
    (fact type-attr-uniqueness-use)
    (expected outcome))
  (list candidates semantic-candidate))
