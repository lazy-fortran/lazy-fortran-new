(schema standardir-grammar-v0
  (primitive name)
  (primitive int)
  (primitive bool)
  (enum node-kind reference token sequence choice optional repeat)
  (enum origin mechanical search smt llm llm-repair human imported differential)
  (enum resolution resolved unresolved disputed)
  (record source-ref
    (document name)
    (clause name)
    (rule name)
    (page int)
    (source-hash name))
  (record grammar-node
    (kind node-kind)
    (name name)
    (minimum int)
    (unbounded bool)
    (first-child int)
    (child-count int))
  (list grammar-nodes grammar-node)
  (record syntax-rule
    (id name)
    (alternative int)
    (lhs name)
    (root int)
    (nodes grammar-nodes)
    (source source-ref)
    (origin origin)
    (resolution resolution)))
