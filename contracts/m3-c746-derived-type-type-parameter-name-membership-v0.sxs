(schema m3-c746-derived-type-type-parameter-name-membership-v0
  (primitive name)
  (enum outcome accepted rejected unresolved)
  (enum c746-definition-name-presence absent present unknown)
  (enum c746-declared-name-relation member not-member unknown)
  (enum c746-context derived-type-def other unknown)
  (record source-ref
    (document name)
    (clause name)
    (rule name)
    (page int)
    (source-hash name))
  (record source-span
    (byte-start int)
    (byte-length int)
    (page-start int)
    (page-end int))
  (record type-parameter-name-membership
    (definition-name-presence c746-definition-name-presence)
    (declared-name-relation c746-declared-name-relation)
    (context c746-context))
  (record semantic-candidate
    (id name)
    (property name)
    (source source-ref)
    (span source-span)
    (fact type-parameter-name-membership)
    (expected outcome))
  (list candidates semantic-candidate))
