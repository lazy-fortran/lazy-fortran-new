(schema m3-c761-pointer-presence-v0
  (primitive name)
  (enum outcome accepted rejected unresolved)
  (enum pointer-presence absent present unknown)
  (record source-ref (document name) (clause name) (rule name) (page int) (source-hash name))
  (record source-span (byte-start int) (byte-length int) (page-start int) (page-end int))
  (record pointer-presence-fact (pointer-presence pointer-presence))
  (record semantic-candidate (id name) (property name) (source source-ref) (span source-span) (fact pointer-presence-fact) (expected outcome))
  (list candidates semantic-candidate))
