(schema l3-print-list-v0
  (primitive name)
  (primitive int)
  (enum result accepted rejected)
  (record source-case
    (id name)
    (path name)
    (sha256 name)
    (expected result))
  (record source-evidence
    (document name)
    (pdf-sha256 name)
    (standardir-path name)
    (standardir-sha256 name)
    (rules name)
    (pages int))
  (record print-list-contract
    (property name)
    (positive source-case)
    (positive-wide source-case)
    (negative-empty source-case)
    (negative-missing-item source-case)
    (negative-write source-case)
    (negative-name source-case)
    (evidence source-evidence)))
