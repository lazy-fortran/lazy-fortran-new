(schema l3-print-expression-decimal-constant-zero-v0
  (primitive name)
  (primitive int)
  (enum result accepted rejected)
  (record source-case
    (id name)
    (path name)
    (sha256 name)
    (expected result))
  (record source-evidence
    (document name)
    (pdf-sha256 name)
    (standardir-path name)
    (standardir-sha256 name)
    (rules name)
    (pages int))
  (record print-expression-decimal-constant-zero-contract
    (property name)
    (positive-zero source-case)
    (positive-boundary source-case)
    (negative-missing-operand source-case)
    (negative-real-right source-case)
    (negative-out-of-range source-case)
    (negative-write source-case)
    (negative-name source-case)
    (evidence source-evidence)))
